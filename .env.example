# Copy to .env and fill in. Free signups, no card required.

# 600 verifications/month — reoon.com/email-verifier
REOON_API_KEY=

# 25 searches + 50 verifications/month — hunter.io
HUNTER_API_KEY=

# 100 credits/month on a personal Gmail signup — apollo.io
APOLLO_API_KEY=

# Gmail label your application confirmations get filtered into
GMAIL_LABEL=job-applications

# Contact confidence floor (0-100). Below this = "no contact found".
CONFIDENCE_FLOOR=80

# Stop processing new applications when this many drafts sit unreviewed.
MAX_OPEN_DRAFTS=15
